# Copy to .env (never committed) or set these as environment variables in the cloud environment settings.
WP_LIVE_URL=https://crescentcitycopper.com
# Staging copy of the WordPress site (address to be supplied; all WordPress work happens there)
WP_STAGING_URL=
# WordPress application password for a staging user (e.g. "claude-build")
WP_USER=claude-build
WP_APP_PASSWORD=
# WooCommerce REST API keys (staging, READ-ONLY permission)
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
