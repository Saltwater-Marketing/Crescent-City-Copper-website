# Copy to .env (never committed) or set these as environment variables (cloud environment / Netlify).
# WordPress to read products and pages from (read-only). Until launch: the live site. At launch: the shop subdomain.
WC_URL=https://crescentcitycopper.com
# Where cart, checkout and My Account live. Same as WC_URL.
SHOP_URL=https://crescentcitycopper.com
# Optional: WooCommerce REST API key with READ permission (live site). Without it, options are read from the
# public product pages, which gives exactly the same field names.
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
# Local cache for WordPress data, in minutes (0 = always fetch fresh). Netlify always fetches fresh.
WOO_CACHE_MINUTES=60
# ONLY at launch, in Netlify: turns on GA4 + Meta Pixel and lets Google index the site.
# SITE_LIVE=true
# Optional, later: WordPress application password (not needed so far)
WP_USER=claude-build
WP_APP_PASSWORD=
