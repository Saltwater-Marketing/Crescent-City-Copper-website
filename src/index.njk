    <a class="photo-card" href="/home-gallery/"><img src="/assets/img/gallery-home.webp" alt="" loading="lazy" width="800" height="535"><span class="pc-cap"><span class="pc-name">Home Gallery</span><span class="pc-more">View gallery →</span></span></a>
    <a class="photo-card" href="/commercial-custom-gallery/"><img class="top" src="/assets/img/gallery-commercial.webp" alt="" loading="lazy" width="538" height="636"><span class="pc-cap"><span class="pc-name">Commercial &amp; Custom</span><span class="pc-more">View gallery →</span></span></a>
  </div>
  <p class="center more-link"><a href="/photo-gallery/">See every photo gallery</a></p>
</section>

<section class="band-green">
  <div class="wrap grid-2">
    <div>
      <h2 class="h-md">Why Choose Copper</h2>
      <p>Copper forms a patina that protects the metal underneath, so it lasts for decades with little maintenance.</p>
      <a class="btn btn-ghost-light" href="/why-choose-copper/">Read more</a>
    </div>
    <div>
      <h2 class="h-md">Green Products</h2>
      <p>Copper is fully recyclable and can be reused without losing its integrity. Recycling it takes only 15% of the energy needed to produce new copper.</p>
      <a class="btn btn-ghost-light" href="/copper-a-green-product/">Read more</a>
    </div>
  </div>
</section>

{%- if fp %}
<section class="wrap sec">
  <div class="grid-2 align-center">
    {% if fp.image %}<img class="rounded cover-43" src="{{ fp.image.src | img(900) }}" alt="{{ fp.image.alt or fp.title }}" loading="lazy">{% endif %}
    <div>
      <p class="kicker">Featured Project</p>
      <h2 class="h-md">{{ fp.title }}</h2>
      <p>{{ fp.excerpt | truncate(200) }}</p>
      <a class="btn btn-primary" href="{{ fp.path }}">Read more about the project</a>
    </div>
  </div>
</section>
