{%- set fp = null -%}
{%- for p in wp.posts %}{% if not fp %}{% for c in p.categories %}{% if c.slug == 'featured-project' or c.name == 'Featured Project' %}{% set fp = p %}{% endif %}{% endfor %}{% endif %}{% endfor -%}

<section class="hero" aria-label="Banner">
  <img src="/assets/img/hero-awning-brick.webp" srcset="/assets/img/hero-awning-brick-800.webp 800w, /assets/img/hero-awning-brick.webp 1600w" sizes="100vw" alt="Handmade copper awning with wrought iron brackets over a door on a brick building" width="1600" height="1067" fetchpriority="high">
  <div class="hero-tags">
    <div class="hero-tag hero-tag-1"><span>Handmade Copper Awnings</span></div>
    <div class="hero-tag hero-tag-2"><span>Fabricated in New Orleans · Wrought iron brackets included</span></div>
  </div>
</section>

<section class="intro-band">
  <img class="intro-sketch" src="/assets/img/intro-awning-sketch.webp" alt="" aria-hidden="true" width="304" height="197">
  <div class="wrap intro-row">
    <div>
      <h1>Crescent City Copper</h1>
      <p>Your home for copper metal awnings for windows and doors and much more</p>
    </div>
    <div class="btn-row">
      <a class="btn btn-primary" href="/product-category/copper-awnings/">Shop copper awnings</a>
      <a class="btn btn-outline" href="/aboutus/">Learn more</a>
